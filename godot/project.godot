; Engine configuration file.
; ОСОБЫЙ ОТДЕЛ — Android Godot 4
config_version=5

[application]
config/name="ОСОБЫЙ ОТДЕЛ"
; Keep desktop profiles from builds distributed before the title change.
config/use_custom_user_dir.linux=true
config/use_custom_user_dir.windows=true
config/use_custom_user_dir.macos=true
config/custom_user_dir_name.linux="godot/app_userdata/ОТПУСК - TACTICAL"
config/custom_user_dir_name.windows="Godot/app_userdata/ОТПУСК - TACTICAL"
config/custom_user_dir_name.macos="Godot/app_userdata/ОТПУСК - TACTICAL"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.17, 0.20, 1)
